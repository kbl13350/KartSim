<?xml version='1.0' encoding='UTF-8'?>														
 
 <!-- 
		eventId : DB에 저장하는 아이디 값입니다. DB에 catId / eventId 로 저장되므로 각 조건들마다 1부터 1씩 올려주면 됩니다.
		period : 기간 설정

		isRepeat : 해당 이벤트가 반복적으로 나타나야 하는지 명시하는 값입니다.
		합성 N회 조건 같은 경우에는 N회 시도할때마다 나타나줘야한다면 isRepeat='true'로 설정합니다.

		eventCount : 특정 횟수만큼 카운팅되어야 조건부 구매 팝업을 띄우겠다는 count기준 값입니다.

		title : ring_bag에 있는 기본 스트링 말고 다른 제목으로 표시하고 싶을 떄 여기에 설정하면 됩니다.
 -->

 <!--
 레벨 업 시
 <levelUp
	eventId='1'
	period='*~*'
	level='1'			몇 레벨을 달성하면 되는지 표시합니다.
>

휴면 유저 복귀 시
<returnUser
	eventId='1'
	period='*~*'
	isRepeat='true'
	day='30'			마지막 접속일로부터 몇일 지난 사람을 휴면 유저로 취급할 것인지 기준day를 표시합니다.
>

기념일에 최초 접속 시
<anniversary
	eventId='0'
	period='2015-10-14T00:00:00~*'
>

특정 모드 N회 주행 시
<gameJoin
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='false'
	restriction='gameType:SpeedIndi;SpeedTeam;SpeedMatch;BokbulbokSpeedTeam'	퀘스트 리스트릭션 사용되는 gameType, channel 두가지만 유효하게 작동합니다. 
	eventCount = '5'
>

특정 모드 N회 완주 시
<gameGoalIn
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='false'
	restriction='channel:speedIndiInfinit;speedTeamInfinit'
	eventCount = '2'
>

리타이어 시 (특정 모드 설정 가능)
<gameRetire
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='false'
	restriction='gameType:SpeedIndi;SpeedTeam;SpeedMatch;BokbulbokSpeedTeam'
	eventCount = '5'
>

커플 맺었을 시
<coupleSuccess
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
>

커플 등급 업 시
<coupleGradeUp
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
>

합성 시
<exchange
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
	eventCount = '5'
>

튜닝 시
<tuning
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
	onlyFail='true'			실패시에만 카운팅을 하겠다면 true
	eventCount = '5'
>
	
일정 접속 횟수 달성 시
<countLogin
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
	eventCount = '2'
>

도전자 모드 완료 시
<challengerMode
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
	step='10'
>

상점 특정 횟수 진입 시
<enterShop
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
	eventCount = '5'
>

상점에서 특정 횟수 구매 시
<buyShop
	eventId='0'
	period='2015-10-14T00:00:00~*'
	isRepeat='true'
	eventCount = '5'
>

-->


