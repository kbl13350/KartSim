<!--  setType 
			1 =  검색 조건이 몇개 안들어 가서 모든 백터에 대해서 검사를 해야할 경우 사용
			2 =  probItem 100개까지 만들어서 검사 할때 probItem  검색을 id로 검색 즉 검색이 빨라진다. 단점 vector 공간을 100개까지 모두 생성 즉 디테일할 설정이 들어가는 경우아니면 사용안함.
			3 = 2의 방식으로 만들고 누락 된 값에 대해서  확률에 대한 보간을 원할 경우에 세팅을 한다. 
			
			 probItem probValue 경우에  내림 차순으로 놓아야합니다~
-->

<probTable>
	<probSet id='1' probType='1'>
		<probItem probValue='100' rewardPercent='1.00'/>
		<probItem probValue='75' rewardPercent='0.75'/>
		<probItem probValue='50' rewardPercent='0.5'/>
		<probItem probValue='25' rewardPercent='0.25'/>
		<probItem probValue='0' rewardPercent='0'/>
	</probSet>
