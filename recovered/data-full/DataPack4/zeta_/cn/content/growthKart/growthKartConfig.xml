<?xml version='1.0' encoding='UTF-8'?>
<growthKart>
<!-- 
engineGrade - 엔진 종류 (없으면 기본 8로 설정... 추후 나올 엔진 대비)
7 - X
8 - V1

uniqueLevel - 카트 등급 
유니크 : uniqueLevel='1'
레전드 : uniqueLevel='2'
레어 : uniqueLevel='3' 
일반 : uniqueLevel='4'

 priceType - 재화 종류 (루찌, 코인 사용만 개발 되어있음!!! 캐시, 루콘 사용 금지!!!)
 0  : 캐시
 1  : 루찌
 2  : Luccon(중국전용)
 3  : 코인
 
distance - 필요 주행 거리
12.3km = 123

partsPiece - 필요 파츠 조각 개수
-->
	<costInfo>
		<!-- 테스트용 X엔진 설정 -->
<!--
		<cost engineGrade='7' uniqueLevel='4' priceType='1' price='100000'		distance='3000'		partsPiece='800'/>  일반 -> 레어 
		<cost engineGrade='7' uniqueLevel='3' priceType='1' price='400000'		distance='18000'	partsPiece='3600'/> 레어 -> 레전드 
		<cost engineGrade='7' uniqueLevel='2' priceType='1' price='800000'		distance='50000'	partsPiece='12800'/> 레전드 -> 유니크 
-->
		<cost uniqueLevel='4' priceType='1' price='100000'		distance='3000'		partsPiece='800'/> <!-- 일반 -> 레어 -->
		<cost uniqueLevel='3' priceType='1' price='400000'		distance='18000'	partsPiece='3600'/> <!-- 레어 -> 레전드 -->
		<cost uniqueLevel='2' priceType='1' price='800000'		distance='50000'	partsPiece='12800'/> <!-- 레전드 -> 유니크 -->

		<cost engineGrade='9' uniqueLevel='4' priceType='1' price='150000'		distance='2500'		partsPiece='200'/> <!-- 일반 -> 레어 -->
		<cost engineGrade='9' uniqueLevel='3' priceType='1' price='400000'		distance='15000'	partsPiece='1200'/> <!-- 레어 -> 에픽 -->
		<cost engineGrade='9' uniqueLevel='2' priceType='1' price='700000'		distance='20000'	partsPiece='3600'/> <!-- 에픽 -> 레전드 -->
		<cost engineGrade='9' uniqueLevel='1' priceType='1' price='1000000'		distance='50000'	partsPiece='12800'/> <!-- 레전드 -> 유니크 -->
	</costInfo>

<!--	업그레이드 단계 UI 를 gui\windowTemplate\itemPanels.xml 에 설정된 세팅값으로 사용 -->
	<camSet>
		<GrowthKart_Big list='1408,1409,1410' />
	</camSet>

<!--
	cardId  - itemCatId='23' (card)로 만든 아이템 Id
	distance - 아이템 1개당 추가 될 거리 (10km = 100)
	openPeriod - 주행 마일리지 카드 사용 가능 기간
-->
<!-- 20231102 패치에서 주행 마일리지 카드를 캐시판매한 관계로, 사용기간을 무제한으로 설정한다 -->
<!-- 변경할 경우 PM파트에 히스토리 설명 및 확인 필요 -->
	<mileageCardInfo cardId='105' distance='100' openPeriod='*~*'/>

</growthKart>