  <Chapter id="29" name="chapter_beach2" title="街头飙车" desc="滨海大道 阿嘉的挑战！冲向胜利！ 阿嘉要参加飙车的宣誓！ 可以寻找爱车的唯一途径是，在飙车赛打败暴走联盟。 职业冲浪手阿嘉的飙车挑战就此开始！" selectImage="info_beach2" active="true" level="2" bgmTheme="beach"/>
  <Chapter id="28" name="chapter_beach" title="街头飙车" desc="新伙伴阿嘉的车辆被盗。 发现被盗车辆的地点就是进行飙车的现场！ 为了找回丢失的车辆，参加飙车的阿嘉！ 比海边太阳更炙热的友情与爱情的故事即将拉开帷幕。" selectImage="info_beach" active="true" level="2" bgmTheme="beach"/>
  <Chapter id="27" name="chapter_black3" title="黑杰克与黑暗组织" desc="寻找星陨之石，妄想统治世界的黑暗组织！ BOSS黑杰克与行动队长格雷兄弟的故事即将开始。 把世界逼向绝路的坏蛋们的故事！" selectImage="info_black3" active="true" rewardMsg="恭喜~获得了黑暗主题故事模式的奖励。" bgmTheme="moonhill" level="2"/>
  <Chapter id="26" name="chapter_black2" title="寻找星陨之石！" desc="时时刻刻接近的灭绝危机 还有主宰这场危机的神秘团体黑暗组织与星陨之石！ 现在黑暗组织与为了阻挡他们的伙伴们的第二个故事正式开始！" selectImage="info_black2" active="true" rewardMsg="恭喜~获得了黑暗主题故事模式的奖励。" bgmTheme="moonhill" level="2"/>
  <Chapter id="25" name="chapter_black1" title="黑暗组织登场" desc="时时刻刻接近的灭绝危机，还有主宰这场危机的神秘团体黑暗组织与星陨之石！现在黑暗组织与为了阻挡他们的伙伴们的故事正式拉开帷幕！" selectImage="info_black1" active="true" rewardMsg="恭喜~获得了黑暗主题故事模式的奖励。" bgmTheme="moonhill" level="2"/>
  <Chapter id="22" name="chapter_boomhill" title="繁荣山丘的邀请！" desc="莱恩与莉亚被邀请到一年一度的繁荣山丘赛车大会上。 遇见实力不凡的伙伴们，一同展开激烈的对决... 莱恩与莉亚是否能和新朋友们融洽的相处呢？" selectImage="info_boomhill" active="true" rewardKeyItemId="0" chapterKeyItemId="0" level="2" bgmTheme="village"/>
