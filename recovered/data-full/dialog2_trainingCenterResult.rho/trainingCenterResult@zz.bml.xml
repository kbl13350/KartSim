<?xml version="1.0" encoding="UTF-8"?>
<Panel windowRect="fullscreen" color="100 0 0 0" alphaBlend="true">
  <CaptionWindow name="caption" frame="CaptionDialog" windowRect="0 0 560 370" caption="#sb(missionComplete)" align="center" setCloseButton="cancelButton">
    <ImageBoard name="nextMissionImg" leftTopWH="-11 -1 512 168" image="tc_resultCenterBg" adjust="0 -60" align="center" alphaBlend="true" visible="false">
      <Panel windowSize="64 64" texture="licenseMissionBg" adjust="-110 -20" align="center" alphaBlend="true">
        <Panel name="curIcon" windowSize="62 62" align="center" alphaBlend="true"/>
        <Panel windowSize="64 64" texture="riderSchoolPro_clear@zz" alphaBlend="true"/>
        <Label name="curLbl" windowSize="50 20" align="center" textAlign="center" adjust="0 50" textRender="bold16" textColor="255 42 55 80"/>
      </Panel>
      <Panel windowSize="72 36" adjust="0 -20" texture="tc_arrow" align="center" alphaBlend="true"/>
      <Panel windowSize="64 64" texture="licenseMissionBg" adjust="110 -20" align="center" alphaBlend="true">
        <Panel name="nextIcon" windowSize="62 62" align="center" alphaBlend="true"/>
        <Label name="nextLbl" windowSize="50 20" align="center" textAlign="center" adjust="0 50" textRender="bold16" textColor="255 42 55 80"/>
      </Panel>
    </ImageBoard>
    <ImageBoard name="lastMissionImg" leftTopWH="-11 -1 512 168" image="tc_resultCenterBg" adjust="0 -60" align="center" alphaBlend="true" visible="false">
      <Panel windowSize="64 64" texture="licenseMissionBg" adjust="0 -20" align="center" alphaBlend="true">
        <Panel name="lastIcon" windowSize="62 62" align="center" alphaBlend="true"/>
        <Panel windowSize="64 64" texture="riderSchoolPro_clear@zz" alphaBlend="true"/>
        <Label name="lastLbl" windowSize="50 20" align="center" textAlign="center" adjust="0 50" textRender="bold16" textColor="255 42 55 80"/>
      </Panel>
    </ImageBoard>
    <ColorLabel name="resultText1" leftTopWH="0 0 500 20" align="center" adjust="0 50" textAlign="center" textRender="bold16" textColor="255 42 55 80"/>
    <ColorLabel name="resultText2" leftTopWH="0 0 500 20" align="center" adjust="0 72" textAlign="center" textRender="bold16" textColor="255 42 55 80"/>
    <Window windowRect="0 260 490 261" frame="VSection" align="hcenter"/>
    <TextButton name="okButton" windowRect="0 272 130 314" align="hcenter" text="#sb(ok)" textRender="bold16"/>
  </CaptionWindow>
</Panel>
