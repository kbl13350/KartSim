<?xml version="1.0" encoding="UTF-8"?>
<Panel windowRect="fullscreen" color="100 0 0 0" alphaBlend="true">
  <CaptionWindow name="clubNameChange" windowRect="0 0 406 283" frame="CaptionDialog" caption="#sb(changeClubName)" align="center" textRender="bold">
    <Label windowSize="350 26" adjust="0 10" align="hcenter" text="#sb(clubName)" textColor="255 80 80 80" textAlign="center" textRender="bold16" enable="false"/>
    <Container windowSize="350 26" align="hcenter" adjust="0 41">
      <Edit name="edit" frame="DefaultEdit" windowSize="350 26" align="left;vcenter" maxChar="10" textColor="255 42 55 80" textAlign="center" textRender="bold16"/>
      <Label name="editGuide" windowSize="350 26" align="left;vcenter" text="#sb(clubNameEdit)" textColor="255 183 186 194" textAlign="center" textRender="bold16" enable="false"/>
    </Container>
    <Window windowSize="350 26" adjust="0 71" frame="GrayInputBox" align="hcenter" alphaBlend="true">
      <Label windowSize="70 26" adjust="10 -1" align="left,vcenter" text="#sb(clubCapital)" textColor="255 88 105 129" textAlign="center" textRender="bold14"/>
      <Label name="clubCapital" windowSize="245 26" adjust="35 -1" align="right,vcenter" text="" textColor="255 88 105 129" textAlign="right,vcenter" textRender="bold14"/>
      <Label windowSize="35 26" adjust="0 -1" align="right,vcenter" text="#sb(lucci)" textColor="255 88 105 129" textAlign="center" textRender="bold14"/>
    </Window>
    <Label name="info" windowSize="350 26" adjust="0 110" align="hcenter" text="#sb(changeClubNameInfo)" textColor="255 72 106 163" textAlign="center" textRender="bold14"/>
    <Window leftTopWH="0 0 350 1" frame="HSection" align="hcenter;bottom" adjust="0 63"/>
    <Container windowRect="0 0 274 42" align="hcenter;bottom" adjust="0 6">
      <TextButton name="ok" leftTopWH="0 0 132 42" text="#sb(ok)" textRender="bold16" textColor="white" overTextColor="white" clickedTextColor="255 24 55 104" disabledTextColor="255 220 220 220"/>
      <TextButton name="cancel" leftTopWH="0 0 132 42" align="right" text="#sb(cancel)" textRender="bold16" textColor="255 64 75 95" overTextColor="255 106 120 147" clickedTextColor="255 35 41 52" disabledTextColor="255 131 131 131"/>
    </Container>
  </CaptionWindow>
</Panel>
