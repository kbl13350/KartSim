<?xml version="1.0" encoding="UTF-8"?>
<Tutorial name="tutorialScript">
  <Page template="1" text="[color:yellow]유물 조사단 이벤트 배우기[/color]" font="default" textColor="black"/>
  <Page template="4" text="|유물 조사단 이벤트는|주사위를 굴려서 보물을 찾아|모험을 떠나는|새로운 이벤트입니다." font="default" image="유물조사단로고@zz" textColor="black"/>
  <Page template="1" text="[color:yellow]주사위 획득 및 사용 방법[/color]" font="default" textColor="black"/>
  <Page template="4" text="||주사위 획득 방법" font="default" image="주사위" textColor="black"/>
  <Page template="3" text="아이템 모드는|아이템 큐브 획득 시~ ." image="큐브1@zz" image2="큐브2@zz" font="default"/>
  <Page template="4" text="||스피드 모드는|드리프트 시~ ." image="드리프트" font="default"/>
  <Page template="4" text="||주사위|획득이 가능해요!|" image="주사위" font="default" textColor="black"/>
  <Page template="4" text="|다른 모드에서도|드리프트 또는,|큐브 획득 시|주사위를 획득할 수 있어요!" image="주사위" font="default" textColor="black"/>
  <Page template="3" text="주사위 보유 수량은 맨 위|보유 수량에서 확인하세요!" image="전체@zz" image2="수량@zz" font="default"/>
  <Page template="4" text="||주사위|사용 방법" image="주사위" font="default" textColor="black"/>
  <Page template="3" text="유물 조사단 주사위 굴리기|버튼을 클릭하세요!" image="전체@zz" image2="굴리기@zz" font="default"/>
  <Page template="4" text="||주사위 굴리기가|자동으로 진행돼요!" image="자동굴리기" font="default"/>
  <Page template="4" text="||주사위 결과에 따라|말이 자동으로 움직여요!" image="자동이동" font="default"/>
  <Page template="4" text="|그리고|주사위 숫자 1은|더블을 의미해요!" image="더블" font="default"/>
  <Page template="4" text="|더블은|이동 후 무료로 한번 더|주사위를 굴리 수 있어요!!" image="자동굴리기" font="default"/>
  <Page template="1" text="[color:yellow]이제 보상을|업그레이드해 볼까요?[/color]" font="default" textColor="black"/>
  <Page template="4" text="|유적 슬롯에 도착하면|지금 보상을 받는 &quot;획득&quot;과|보상을 업그레이드하는|&quot;업그레이드&quot; 버튼을|선택할 수 있어요!" image="유적" font="default" textColor="black"/>
  <Page template="3" text="획득 버튼은 현재 보상을|받는 버튼이에요!" image="업그레이드팝업@zz" image2="확인@zz" font="default" textColor="black"/>
  <Page template="3" text="업그레이드 버튼은 더 좋은|보상 받는 방법이에요!!" image="업그레이드팝업@zz" image2="업그레이드@zz" font="default" textColor="black"/>
  <Page template="4" text="|업그레이드를 선택하면|가치가 높은 보상을|받을 수 있지만 다시|도착해야 받을 수 있어요!" image="유적" font="default" textColor="black"/>
  <Page template="1" text="[color:yellow]숨겨진 보물은 무엇일까요?[/color]" font="default" textColor="black"/>
  <Page template="4" text="||숨겨진 보물은|보물 상자가 놓여 있는 곳에 있어요!!" image="보물상자" font="default"/>
  <Page template="4" text="||보물 상자가 놓여 있는 곳에|도착하면 놀라운 선물을 받을 수 있어요!" image="보물상자1" font="default"/>
  <Page template="4" text="||하지만, 보물 상자는|완주 시점에 위치가 변경돼요!" image="보물상자" font="default"/>
  <Page template="4" text="||보물 상자를 찾아|숨겨진 보물을 얻어봐요!" image="보물상자" font="default"/>
  <Page template="1" text="[color:yellow]마지막으로 완주를 알아 볼까요?[/color]" font="default" textColor="black"/>
  <Page template="4" text="|시작 위치에서 시작해서|다시 시작 위치로|돌아오는 것을 완주라고 해요!" image="시작" font="default"/>
  <Page template="3" text="완주 횟수는 맨 위|완주 횟수에서 확인하세요!!" image="전체@zz" image2="완주횟수@zz" font="default"/>
  <Page template="1" text="[color:yellow]이제 최고의 보물을 찾아|유물 조사단을 즐겨 보세요!![/color]" font="default" textColor="black"/>
</Tutorial>
