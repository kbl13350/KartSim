<?xml version="1.0" encoding="UTF-8"?>
<Panel name="desktop" windowRect="fullscreen" color="200 0 0 0" alphaBlend="true">
  <Container windowSize="1024 768" align="center">
    <ImageBoard windowSize="989 749" align="center" adjust="0 0" alphaBlend="true" alphaTest="true" image="bg@zz">
      <GridSelectorEx name="shopItemSelector" windowSize="0 0" adjust="162 230" alignSize="5" maxLine="2" alignMargin="0 2" clientMargin="0 0 0 0"/>
      <Label windowSize="550 60" adjust="190 575" multiline="true" lineGap="3" textAlign="center" textColor="255 255 216 0" text="#sb(secretShopDesc)"/>
      <Container windowSize="150 30" adjust="805 303">
        <Label name="curKoin" windowSize="95 30" adjust="0 0" textAlign="vcenter;right" textColor="255 255 216 0" textRender="bold" text="0"/>
        <Label windowSize="30 30" adjust="100 0" textAlign="vcenter" textColor="255 255 216 0" text="#sb(koin)"/>
        <ImageButton name="buyKoin" windowSize="22 22" adjust="0 0" align="vcenter;right" autoLoadImage="btn_plus_" alphaBlend="true"/>
      </Container>
      <Container windowSize="160 30" adjust="795 373">
        <Label name="curCash" windowSize="95 30" adjust="0 0" textAlign="vcenter;right" textColor="255 255 216 0" textRender="bold" text="0"/>
        <Label windowSize="30 30" adjust="100 0" textAlign="vcenter" textColor="255 255 216 0" text="#sb(cash)"/>
        <ImageButton name="buyCash" windowSize="22 22" adjust="0 0" align="vcenter;right" autoLoadImage="btn_plus_" alphaBlend="true"/>
      </Container>
      <Container windowSize="160 30" adjust="798 442">
        <Label name="curLucci" windowSize="95 30" adjust="0 0" textAlign="vcenter;right" textColor="255 255 216 0" textRender="bold" text="0"/>
        <Label windowSize="30 30" adjust="100 0" textAlign="vcenter" textColor="255 255 216 0" text="#sb(lucci)"/>
      </Container>
      <Container windowSize="150 75" adjust="805 525">
        <Label windowSize="150 20" adjust="0 0" textAlign="center" textColor="255 255 216 0" textRender="bold" text="#sb(secretShopTimeLeft)"/>
        <CharPanel name="timeLeftMin" windowSize="60 50" adjust="85 23" align="right" texture="남은시간숫자" fontPos="0 0" fontSize="44 51" fontStr="0123456789" spaceOffset="-15" alphaBlend="true" text="00"/>
        <CharPanel name="timeLeftSec" windowSize="60 50" adjust="85 23" align="left" texture="남은시간숫자" fontPos="0 0" fontSize="44 51" fontStr="0123456789" spaceOffset="-15" alphaBlend="true" text="00"/>
      </Container>
    </ImageBoard>
    <ImageBoard name="timeOver" windowSize="610 150" adjust="180 320" alphaBlend="true" alphaTest="true" image="초기화화면창" visible="false">
      <Label windowSize="200 60" adjust="0 0" align="center" multiline="true" lineGap="3" textAlign="center" textColor="255 95 249 255" text="#sb(secretShopTimeOver)"/>
    </ImageBoard>
    <ImageButton name="closeButton" windowSize="20 20" adjust="180 113" align="top;right" autoLoadImage="close_" alphaBlend="true" altText="#sb(close)"/>
  </Container>
</Panel>
