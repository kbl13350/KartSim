<?xml version="1.0" encoding="UTF-8"?>
<Panel windowRect="fullscreen" color="100 0 0 0" alphaBlend="true">
  <CaptionWindow frame="CaptionDialog" windowRect="0 0 395 180" caption="#sb(slotNameChange)" align="center" setCloseButton="cancelButton">
    <Label leftTopWH="0 8 200 30" align="hcenter" textRender="default" text="#sb(slotNameChangeStr)" textAlign="center" lineGap="6"/>
    <Edit name="editSlotName" leftTopWH="0 45 250 30" align="hcenter" textAlign="center" maxChar="12"/>
    <Container windowRect="0 0 145 30" align="hcenter;bottom">
      <Window windowRect="0 -10 340 -8" frame="VSection" align="hcenter"/>
      <TextButton name="okButton" windowRect="0 0 87 30" text="#sb(ok)"/>
      <TextButton name="cancelButton" windowRect="0 0 52 30" align="right" text="#sb(cancel)"/>
    </Container>
  </CaptionWindow>
</Panel>
