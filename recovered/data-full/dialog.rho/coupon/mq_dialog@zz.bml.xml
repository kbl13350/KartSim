      <Window windowRect="0 -10 250 -8" frame="Section" align="hcenter" enable="false"/>
      <TextButton name="btnReceive" windowRect="0 0 87 30" text="#sb(ok)"/>
      <TextButton name="btnCancelReceive" windowRect="0 0 52 30" align="right" text="#sb(cancel)"/>
    </Container>
  </CaptionWindow>
  <ToolTipWindow name="contents" windowRect="0 0 200 100" frame="DefaultTooltip" marginRect="0 0  -5 -10" textColor="white" vertAutoSizing="true" autoWrap="true" multiLine="true" depthBias="1024" text="ABCD" visible="false"/>
</Container>
