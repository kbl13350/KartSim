    <Label windowSize="408 26" adjust="0 10" align="hcenter" textRender="bold16" textColor="255 42 55 80" text="#sb(enterCouponNo)" textAlign="center" enable="false"/>
    <Edit name="couponNo" windowSize="408 26" adjust="0 40" align="hcenter" maxChar="30" textRender="bold16" textColor="255 42 55 80" textAlign="center"/>
    <Window windowSize="408 1" frame="HSection" adjust="0 63" align="hcenter;bottom"/>
