<?xml version="1.0" encoding="UTF-8"?>
<CaptionWindow leftTopWH="0 0 600 490" align="center" frame="CaptionDialog" caption="#sb(cashInvenCaption)" captionPos="0 1" captionColor="white">
  <ImageButton name="closeButton" windowSize="64 20" align="right" adjust="5 -25" autoLoadImage="btn_exit_" alphaBlend="true">
    <Label name="sessionStateStr" windowRect="22 0 60 22" align="vcenter" text="#sb(exit)" textColor="white" textRender="bold" textAlign="center"/>
  </ImageButton>
  <Label leftTopWH="0 5 560 20" align="hcenter" text="#sb(cashInvenText1)" textAlign="hcenter"/>
  <Label leftTopWH="0 20 560 20" align="hcenter" text="#sb(cashInvenText2)" textAlign="hcenter"/>
  <Window leftTopWH="0 40 550 305" align="hcenter" frame="GrayEdit">
    <GridSelectorEx name="invenList" windowSize="530 290" adjust="10 0" alignSize="2" maxLine="5" alignMargin="10 7" linePaging="false"/>
    <Panel leftTopWH="0 271 50 22" align="hcenter" texture="img_numberBG" alphaBlend="true">
      <Label name="page" leftTopWH="0 0 50 22" text="1 / 2" textAlign="center" textColor="white"/>
    </Panel>
    <ImageButton name="left" leftTopWH="0 270 160 24" align="left" adjust="60 0" autoLoadImage="btn_left_" alphaBlend="true"/>
    <ImageButton name="right" leftTopWH="0 270 160 24" align="right" adjust="60 0" autoLoadImage="btn_right_" alphaBlend="true"/>
  </Window>
  <Label leftTopWH="0 355 550 0" align="hcenter" multiLine="true" autoWrap="true" vertAutoSizing="true" text="#sb(cashInvenText3)" textAlign="hcenter"/>
  <Window leftTopWH="0 400 560 3" align="hcenter" frame="HSection"/>
  <TextButton name="confirm" windowSize="100 30" adjust="-60 410" align="hcenter" frame="DefaultFocusedButton" text="#sb(cashInvenOk)" textRender="bold" textColor="white"/>
  <TextButton name="refund" windowSize="100 30" adjust="60 410" align="hcenter" frame="DefaultStaticButton" text="#sb(cashInvenCancel)"/>
</CaptionWindow>
