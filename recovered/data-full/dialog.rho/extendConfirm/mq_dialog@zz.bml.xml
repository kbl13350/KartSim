<?xml version="1.0" encoding="UTF-8"?>
<Panel windowRect="fullscreen" color="100 0 0 0" alphaBlend="true">
  <CaptionWindow frame="CaptionDialog" windowRect="0 0 550 460" caption="#sb(extendConfirmCaption)" align="center" setCloseButton="cancelButton">
    <Container windowRect="0 8 500 90" align="hcenter">
      <Panel name="iconPanel" windowSize="31 30" adjust="30 -7" align="vcenter" uvRect="0 0 31 30" texture="대화상자정보" alphaBlend="true"/>
      <Label windowRect="90 0 300 70" text="#sb(extendWarningMsg)" textRender="bold" textAlign="vcenter" multiLine="true"/>
    </Container>
    <Container windowRect="0 95 512 310" align="hcenter">
      <Panel windowSize="512 214" adjust="0 0" texture="기간연장팝업_bg@zz"/>
      <ItemWindow name="itemPanel" windowSize="150 150" adjust="200 30" alphaBlend="true" enable="false"/>
      <Label name="before" windowSize="250 20" adjust="10 180" text="우왕국" textColor="white" textRender="bold" textAlign="hcenter;vcenter"/>
      <Label name="after" windowSize="250 20" adjust="250 180" text="대왕국" textColor="red" textRender="bold" textAlign="hcenter;vcenter"/>
    </Container>
    <Label windowSize="515 45" frame="DefaultEdit" adjust="0 315" text="#sb(extendQuestion)" multiLine="true" textAlign="hcenter;vcenter" textRender="bold" align="hcenter"/>
    <Container windowRect="0 0 145 30" align="hcenter;bottom">
      <Window windowRect="0 -10 515 -8" frame="VSection" align="hcenter"/>
      <TextButton name="okButton" windowRect="0 0 87 30" text="#sb(yes)"/>
      <TextButton name="cancelButton" windowRect="0 0 52 30" align="right" text="#sb(no)"/>
    </Container>
  </CaptionWindow>
</Panel>
