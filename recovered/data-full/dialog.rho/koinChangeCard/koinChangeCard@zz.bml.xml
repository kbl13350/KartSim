<?xml version="1.0" encoding="UTF-8"?>
<Panel windowRect="fullscreen" color="100 0 0 0" alphaBlend="true">
  <CaptionWindow name="mainWindow" windowRect="0 0 350 400" caption="#sb(koinChange)" align="center" frame="CaptionDialog" setCloseButton="cancelButton">
    <Window name="transFillPlane" windowRect="0 7 320 200" align="hcenter" frame="ItemPanel" enable="false"/>
    <Window name="main" windowSize="250 222" align="hcenter"/>
    <Label name="msg" leftTopWH="0 205 300 40" multiLine="true" text="" textAlign="center"/>
    <Window leftTopWH="20 240 200 50">
      <ImageCheckButton name="useMe" leftTopWH="0 10 16 16" autoImage="btn_radio_" alphaBlend="true"/>
      <Label windowRect="25 12 95 29" text="#sb(useMe)" textRender="bold"/>
      <ImageCheckButton name="giveOther" leftTopWH="0 30 16 16" autoImage="btn_radio_" alphaBlend="true"/>
      <Label windowRect="25 31 95 51" text="#sb(giftOther)" textRender="bold"/>
    </Window>
    <Container name="type2" windowRect="0 0 350 30" align="hcenter;bottom">
      <Window windowRect="0 -10 316 -8" frame="VSection" align="hcenter"/>
      <TextButton name="ok" windowSize="80 30" text="#sb(ok)" align="hcenter"/>
    </Container>
    <Window name="findRider" leftTopWH="0 300 320 100" frame="GrayEdit" visible="false">
      <Label name="confirm_text" windowRect=" 10 194 11" text="#sb(inputRiderName)"/>
      <Edit name="RiderEdit" windowRect="0 35 305 57" maxChar="16" enable="false"/>
      <ComboBox name="cmbFriendList" windowRect="0 63 305 85" comboListLength="80" scrollBarVisible="true" enable="false"/>
    </Window>
    <StringBag>
      <k n="koinChange">
        <m c="kr" v="프리미엄 코인 카드"/>
        <m c="cn" v="VIP会员酷币卡"/>
        <m c="tw" v="我的VIP KOIN卡片"/>
      </k>
      <k n="giveGift">
        <m c="kr" v="선물하기"/>
        <m c="cn" v="赠送礼物"/>
        <m c="tw" v="贈送禮物"/>
      </k>
      <k n="useMe">
        <m c="kr" v="내가 사용하기"/>
        <m c="cn" v="使用"/>
        <m c="tw" v="使用"/>
      </k>
      <k n="giftOther">
        <m c="kr" v="친구에게 선물하기"/>
        <m c="cn" v="赠送"/>
        <m c="tw" v="送禮"/>
      </k>
      <k n="inputRiderName">
        <m c="kr" v="선물 받을 라이더명을 입력하세요"/>
        <m c="cn" v="请输入车手名称"/>
        <m c="tw" v="請輸入贈禮的車手名稱"/>
      </k>
      <k n="selfGiftError">
        <m c="kr" v="자기 자신에게 선물할 수 없습니다."/>
        <m c="cn" v="不能自己给自己送礼物"/>
        <m c="tw" v="無法送禮給自己。"/>
      </k>
    </StringBag>
  </CaptionWindow>
</Panel>
