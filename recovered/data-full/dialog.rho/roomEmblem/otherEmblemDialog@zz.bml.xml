<?xml version="1.0" encoding="UTF-8"?>
<Panel windowRect="fullscreen" color="100 0 0 0" alphaBlend="true">
  <CaptionWindow name="roomEmblemFrame" windowRect="0 0 580 430" caption="#sb(dialogTitle)" align="center" frame="CaptionDialog" setCloseButton="Cancel">
    <Label windowSize="100 100" align="hcenter" adjust="0 10" text="#sb(comment)" textRender="bold16" textColor="255 42 55 80" autoSizing="true"/>
    <Window name="transFillPlane" windowSize="550 245" align="center" adjust="0 -10" frame="PopupWindow"/>
    <Label name="emblemCount" windowSize="100 20" adjust="0 54" align="hcenter" text="#sb(emblemCount)" textRender="bold16" textColor="white" textAlign="center"/>
    <GridSelector name="emblemList" windowRect="10 90 550 300" alignStyle="horizontal" alignSize="6" maxLine="2" alignMargin="10 10" clientMargin="0 0 0 0"/>
    <Container windowSize="120 22" adjust="0 84" align="hcenter;bottom">
      <Label name="page" windowSize="100 20" text="0 / 0" textRender="bold16" textColor="255 42 55 80" autoSizing="true" align="center"/>
      <TextButton name="prevPage" windowRect="0 0 20 22" frame="BulletLeftButton" useDisableState="true" align="bottom"/>
      <TextButton name="nextPage" windowRect="0 0 20 22" frame="BulletRightButton" useDisableState="true" align="right;bottom"/>
    </Container>
    <Window windowSize="550 1" frame="HSection" adjust="0 60" align="hcenter;bottom"/>
    <TextButton name="OK" windowSize="132 40" adjust="0 0" align="hcenter; bottom" text="#sb(ok)" textRender="bold16" textColor="white" overTextColor="white" clickedTextColor="255 24 55 104" disabledTextColor="255 220 220 220" frame="DefaultFocusedButton"/>
  </CaptionWindow>
</Panel>
