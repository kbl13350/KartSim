<?xml version="1.0" encoding="UTF-8"?>
<Container name="desktop" windowRect="fullscreen">
  <CaptionWindow name="createWindow" frame="CaptionDialog" windowRect="100 150 510 390" align="center" setCloseButton="cancelButton" visible="false">
    <Label windowRect="15 5 385 35" frame="GrayUnderLine" enable="false" name="bodyLabel" textAlign="hcenter" align="hcenter" textColor="black"/>
    <Label windowRect="30 45 100 60" text="#sb(inputPassword2nd)"/>
    <Label windowRect="30 75 100 90" text="#sb(confirmPassword2nd)"/>
    <Edit name="newPasswordEdit" windowRect="150 40 300 60" frameSet="GlassButton" fillTrans="true" multiLine="true" autoWrap="true" lineGap="1" textColor="black" text="" maxChar="32" passEdit="true"/>
    <Edit name="newPasswordEditConfirm" windowRect="150 70 300 90" frameSet="GlassButton" fillTrans="true" multiLine="true" autoWrap="true" lineGap="1" textColor="black" text="" maxChar="32" passEdit="true"/>
    <TextButton name="okButton" text="#sb(ok)" windowRect="100 150 170 175" altTextRender="outline"/>
    <TextButton name="cancelButton" text="#sb(cancel)" windowRect="190 150 260 175" altTextRender="outline"/>
  </CaptionWindow>
  <CaptionWindow name="changeWindow" frame="CaptionDialog" windowRect="100 150 510 390" align="center" visible="false">
    <Label windowRect="15 5 385 35" frame="GrayUnderLine" enable="false" name="bodyLabel" textAlign="hcenter" align="hcenter" textColor="black"/>
    <Label windowRect="30 45 100 60" text="#sb(originalPassword2nd)"/>
    <Label windowRect="30 75 100 90" text="#sb(newPassword2nd)"/>
    <Label windowRect="30 105 100 120" text="#sb(confirmNewPassword2nd)"/>
    <Edit name="orgPasswordEdit" windowRect="150 40 300 60" frameSet="GlassButton" fillTrans="true" multiLine="true" autoWrap="true" lineGap="1" textColor="black" text="" maxChar="32" passEdit="true"/>
    <Edit name="newPasswordEdit" windowRect="150 70 300 90" frameSet="GlassButton" fillTrans="true" multiLine="true" autoWrap="true" lineGap="1" textColor="black" text="" maxChar="32" passEdit="true"/>
    <Edit name="newPasswordEditConfirm" windowRect="150 100 300 120" frameSet="GlassButton" fillTrans="true" multiLine="true" autoWrap="true" lineGap="1" textColor="black" text="" maxChar="32" passEdit="true"/>
    <TextButton name="okButton" text="#sb(ok)" windowRect="100 150 170 175" altTextRender="outline"/>
    <TextButton name="cancelButton" text="#sb(cancel)" windowRect="190 150 260 175" altTextRender="outline"/>
  </CaptionWindow>
</Container>
