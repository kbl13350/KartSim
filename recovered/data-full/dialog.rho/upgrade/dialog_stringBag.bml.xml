    <m c="cn" v="升级后道具"/>
    <m c="tw" v="升級道具"/>
  </k>
  <k n="upgrade">
    <m c="kr" v="업그레이드"/>
    <m c="cn" v="升级"/>
    <m c="tw" v="升級"/>
