    <m c="cn" v="现在要进行升级吗?"/>
    <m c="tw" v="現在要執行升級嗎？"/>
  </k>
  <k n="goUpgrade">
    <m c="kr" v="업그레이드 실행"/>
    <m c="cn" v="开始升级"/>
    <m c="tw" v="執行升級"/>
  </k>
  <k n="checkPoint">
