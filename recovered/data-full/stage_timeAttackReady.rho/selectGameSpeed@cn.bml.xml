<?xml version="1.0" encoding="UTF-8"?>
<CaptionWindow frame="CaptionDialog" caption="#sb(gameSpeed)" windowSize="450 200" adjust="0 0" align="center" captionPos="0 1" captionColor="black">
  <Window name="radioGroup" frame="GrayEdit" windowSize="410 95" adjust="0 5">
    <ImageCheckButton name="S1" windowSize="82 87" adjust="10 5" align="vcenter" autoImage="S1_@zz" alphaBlend="true">
      <Label windowSize="82 87" adjust="0 -8" text="#sb(speedS0)" textColor="white" textAlign="center"/>
    </ImageCheckButton>
    <ImageCheckButton name="S2" windowSize="82 87" adjust="110 5" align="vcenter" autoImage="S2_@zz" alphaBlend="true">
      <Label windowSize="82 87" adjust="0 -8" text="#sb(speedS1)" textColor="white" textAlign="center"/>
    </ImageCheckButton>
    <ImageCheckButton name="S3" windowSize="82 87" adjust="210 5" align="vcenter" autoImage="S3_@zz" alphaBlend="true">
      <Label windowSize="82 87" adjust="0 -8" text="#sb(speedS2)" textColor="white" textAlign="center"/>
    </ImageCheckButton>
    <ImageCheckButton name="S4" windowSize="82 87" adjust="310 5" align="vcenter" autoImage="S4_@zz" alphaBlend="true">
      <Label windowSize="82 87" adjust="0 -8" text="#sb(speedS4)" textColor="white" textAlign="center"/>
    </ImageCheckButton>
  </Window>
  <Container windowRect="0 0 150 30" align="hcenter;bottom">
    <Window windowRect="0 -10 510 -8" frame="VSection" align="hcenter"/>
    <TextButton name="ok" windowRect="0 0 87 30" text="#sb(ok)"/>
    <TextButton name="cancel" windowRect="0 0 52 30" align="right" text="#sb(cancel)"/>
  </Container>
</CaptionWindow>
