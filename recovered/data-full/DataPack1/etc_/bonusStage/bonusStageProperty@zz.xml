<?xml version='1.0' encoding='UTF-8'?>
<!--
	gameType : type - egg or lucci
			 maxCount - 보석 최대갯수
	trackId : 대박트랙 ID
	accionEffect : 퀘스트용, 5개 다 모았을때 사용할 1s
	isForceLocation : 라이더 앞에 강제로 보석위치 시킬때, /대박트랙폴더/track.xml에 isForce 로 조절가능

	pointAddBase : 배틀모드시 난이도에 따른 루찌 plus값 
	time설정시 단위 : sec
	basicLucciType : 대박 트랙에 깔리는 기본 루찌 stateDataOffset (item/Lucci/item.xml 참고)
	specialItemType : 대박 트랙에 깔리는 보너스 루찌 or 아이템 stateDataOffset (item/Lucci/item.xml or item/bonusItem/item.xml 참고)
	rewardItem : stockId or (catId/itemId) 로 설정 가능합니다.
				 지급 아이템이 1개 단일 아이템일 경우에는 catID/itemId 로 설정해 주세요.
-->
<Property>
	<BigTrack>
		<BattleLucci trackId='village_B01'>
			<Game raceTime='20' addRaceTimePerPlayer='0' maximum='41'/>
			<Bonus type='lucci' lucci='5' addLucciPerPlayer='5' addLucciPerAiLevel='2' maximum='55' basicLucciType='1' specialItemType='2' maxSpecialItemCount ='10'/>
		</BattleLucci>
		<BattleEgg trackId='village_B04'>
			<Game raceTime='19' addRaceTimePerPlayer='2' maximum='41'/>
			<Bonus type='item' lucci='5' addLucciPerPlayer='5' addLucciPerAiLevel='2' maximum='55' basicLucciType='1' specialItemType='2' maxSpecialItemCount ='16'/>
			<rewardItem catId='24' itemId='64'/>
		</BattleEgg>
	</BigTrack>
	<BigBoss>
		<GoldDisorder
			silverLotteryId='30007'		silverJewelFxId='0'
			goldLotteryId='30005'		goldJewelFxId='0'
			defeatRwdId='0'		defeatRwdFxId='0' />
	</BigBoss>
</Property>

