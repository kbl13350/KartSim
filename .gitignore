# Local state, dependencies, and build products
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.venv/
**/node_modules/
**/.vite/
**/dist/
**/target/
**/*.log
**/*.part
/server/data/

# Credentials and local configuration
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*cookies*.txt
**/*cookie*.jar

# Generated analysis output with machine-specific decompiler headers
/apk_analysis/jadx/
/apk_analysis/decompiled/*
!/apk_analysis/decompiled/il2cpp_metadata_index.py
/apk_analysis/extracted/assets/bin/Data/Managed/etc/mono/
/apk_analysis/raw_bundles/
