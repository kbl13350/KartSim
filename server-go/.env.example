# docker compose 配置示例。.env 含密码与密钥：只让自己可读，不要提交到仓库。
#   install -m 600 .env.example .env     # 或 (umask 077 && cp .env.example .env)；已有的 .env 用 chmod 600 .env
# 密码与密钥建议只用字母和数字且足够长（至少 24 个字符），例如：openssl rand -hex 24

# 集群共享密钥（至少 32 个字符）：数据服务用它签发入场票据，游戏节点用它验签并调用内部 API。
# 所有节点必须相同；更换后已签发的票据立即失效。生成：openssl rand -base64 48
KART_CLUSTER_SECRET=

# MySQL root 密码与应用账号 kart 的密码。两者都只在 mysql-data 数据卷首次初始化时写入 MySQL；
# 之后只改这里不会改 MySQL 中的密码，kart-data 会因 Access denied 反复重启。更换 kart 的密码：
#   1. docker compose exec mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysql -uroot'
#      mysql> ALTER USER 'kart'@'%' IDENTIFIED BY '<新密码>';
#   2. 把下面的 KART_MYSQL_PASSWORD 改成新密码，再 docker compose up -d kart-data
# root 密码同理：先 ALTER USER 'root'@'%' 与 'root'@'localhost'，再改 MYSQL_ROOT_PASSWORD 并
# docker compose up -d mysql（健康检查用它登录）。
MYSQL_ROOT_PASSWORD=
KART_MYSQL_PASSWORD=

# Redis 密码（必填；Redis 不对宿主机发布，游戏节点也连不到它）。每次启动生效，改完 docker compose up -d 即可。
KART_REDIS_PASSWORD=
# 多套部署共用一个 Redis 时用不同的键前缀；留空为 kart:
# KART_REDIS_PREFIX=

# 发布端口绑定的宿主机地址：127.0.0.1 只允许本机（前面放 Nginx 时使用）；0.0.0.0 对局域网开放。
KART_BIND_ADDR=127.0.0.1

# 浏览器访问各游戏节点所用的 HTTP(S) origin（写进游戏服列表与票据）。
# 经 Nginx 提供 HTTPS 时改成 https://game1.example.com 这类地址；HTTPS 页面只能连 wss://。
KART_GAME_1_PUBLIC_ORIGIN=http://127.0.0.1:8788
KART_GAME_2_PUBLIC_ORIGIN=http://127.0.0.1:8789
KART_GAME_1_NAME=游戏服 1
KART_GAME_2_NAME=游戏服 2

# 单个游戏节点的最大在线人数。
KART_MAX_PLAYERS=400
# 游戏节点的内存防护（见 README“kart-game”变量表）：连接上限默认 KART_MAX_PLAYERS+50，
# 房间上限 200，每连接发送缓冲 1 MiB，未完成 hello 的连接 15 秒后关闭。
# KART_MEMORY_LIMIT_MB 设置后等同 GOMEMLIMIT，接近上限时拒绝新玩家；0 表示不限。
KART_MAX_ROOMS=200
KART_MEMORY_LIMIT_MB=0
# 以下留空（或注释掉）时用程序默认值；KART_MAX_CONNECTIONS 不能小于 KART_MAX_PLAYERS。
# KART_MAX_CONNECTIONS=
# KART_SEND_BUFFER_BYTES=
# KART_HELLO_TIMEOUT=
# WebSocket 压缩（游戏节点 /multiplayer/ws 与数据服务的好友私聊、小屋 WebSocket，两边同用这个变量）：
# 浏览器支持时 512 字节及以上的 JSON 消息压缩发送，运动帧不压。默认开启；代理或浏览器出现兼容问题时设 false。
# KART_WS_COMPRESSION=true

# WebRTC：游戏节点默认同时提供 WebRTC 数据通道（运动帧走不重传、不排队的 UDP 通道，比 WebSocket 延迟更稳），
# 浏览器连不上 UDP 时自动改用 WebSocket。每个节点用一个固定 UDP 端口（游戏服 1 为 8788/udp、游戏服 2 为 8789/udp，
# 与 HTTP 端口同号），compose 把它发布到 KART_BIND_ADDR；KART_WEBRTC_PUBLIC_IPS 填浏览器访问本机所用的 IP
# （本机 127.0.0.1；局域网或公网填对应地址，多个用逗号分隔）。防火墙需放行这两个 UDP 端口。
# KART_WEBRTC=true
KART_WEBRTC_PUBLIC_IPS=127.0.0.1

# 可信主机（逗号分隔，不含端口）：数据服务的 Host 校验与 CORS、游戏节点的 WebSocket Origin 校验都用它。
# 前端页面所在域名必须列入，例如 kart.example.com,game1.example.com,game2.example.com；回环地址总是可信。
KART_LAN_HOSTS=

# 数据服务对浏览器公布的 origin（auth/config 的 backendOrigin），放在反向代理后时设置，例如 https://kart.example.com
KART_DATA_PUBLIC_ORIGIN=

# 引导邀请码：invite 模式下没有任何账号和邀请时作为首个邀请码；任何模式下只要 KART_ADMIN_USERNAMES 中
# 有尚未注册的用户名，每次启动都确保有可用的引导邀请码（优先用这个值；已被使用或留空则另生成随机邀请码）。
# 两种情况都会打印在 kart-data 日志里（grep -i invitation）。
KART_BOOTSTRAP_INVITE=

# ---------------------------------------------------------------- 账号经济 ----
# 见 README.md“账号经济”与 ECONOMY.md。

# 注册方式：open（开放注册，默认）、invite（需要管理员生成的邀请码）、closed（关闭注册，只能登录已有账号）。
KART_REGISTRATION=open

# 管理员用户名（逗号分隔，3–24 位字母、数字、下划线，不区分大小写）。这些账号登录
# <数据服务>/multiplayer/admin 管理页面，查询账号、发放或扣除点券/金币/K币/经验（写流水）。
# 开放注册下首个注册者不再自动成为管理员。顺序：先在这里填自己的用户名并启动；名单中尚未注册的
# 用户名任何模式下都必须带邀请码注册（否则 400 INVALID_INVITE，防止被他人抢注），kart-data 启动时
# 为它们记录错误日志并打印引导邀请码（见 KART_BOOTSTRAP_INVITE）；再用该邀请码注册这个用户名
# （开放注册时在登录界面点“有邀请码？”填入，或用 README“管理页面与发放货币”中的 curl 注册）。
# 数据库中原本 admin=1 的账号保持管理员。
KART_ADMIN_USERNAMES=

# 游客：false（默认）必须登录才能进入联机；true 恢复游客票据（数据服务与游戏节点同时生效）。
KART_ALLOW_GUESTS=false

# 奖励倍率（0–100，默认 1）：数据服务入账时作用于联机比赛与计时赛的经验/金币。只传给数据服务；
# 游戏节点从心跳响应得到倍率，结束快照中显示的奖励与入账一致。
KART_EXP_RATE=1
KART_LUCCI_RATE=1
# 新账号的初始金币。
KART_STARTING_LUCCI=10000

# ---------------------------------------------------------------- 好友与私聊 ----
# 见 README.md“好友与私聊”与 DESIGN.md 第 9 节。数据服务的 WebSocket /api/messenger/ws：
# 连接上限默认 5000（含尚未 hello 的连接，超出时 HTTP 503），每连接发送缓冲默认 262144 字节（至少 65536）。
# 留空（或注释掉）时用程序默认值。
# KART_MESSENGER_MAX_CONNECTIONS=
# KART_MESSENGER_SEND_BUFFER_BYTES=

# 信任其 X-Forwarded-For 的反向代理：IP 或 CIDR，逗号分隔；none 表示不信任任何代理；留空为回环地址。
# 注册按客户端 IP 限流（每个 IP 每小时 5 次），登录按 IP、登录失败按用户名与客户端网段计数
# （见 README“限流与反向代理”）。宿主机上的 Nginx 经发布端口访问 kart-data 时，容器看到的来源是
# cluster 网络的网关，而不是 127.0.0.1；不填写它，所有经 Nginx 的玩家就会共用同一个限流额度。查看网关（容器启动后）：
#   docker network inspect kartsim_cluster -f '{{(index .IPAM.Config 0).Gateway}}'
# 只有在 KART_BIND_ADDR=127.0.0.1、外部访问都经过 Nginx 时才这样填写，否则客户端可以伪造来源地址。
KART_TRUSTED_PROXIES=
